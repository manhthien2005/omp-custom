            "task_id",
            "handoff_id",
            "handoff_sha256",
            "predecessor_revision",
            "predecessor_revision_sha256",
            "revision",
            "revision_sha256",
            "lease_generation"
          ],
          "properties": {
            "task_id": { "type": "string" },
            "handoff_id": { "type": "string" },
            "handoff_sha256": { "$ref": "#/$defs/sha256" },
            "predecessor_revision": { "$ref": "#/$defs/safeInteger" },
